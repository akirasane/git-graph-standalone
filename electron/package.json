{
	"name": "git-graph-standalone",
	"version": "0.0.1",
	"private": true,
	"description": "Standalone Electron shell for Git Graph",
	"author": {
		"name": "akirasane",
		"url": "https://github.com/akirasane"
	},
	"main": "dist/main.js",
	"scripts": {
		"compile": "tsc -p . && node -e \"require('fs').cpSync('src/askpass/askpass.sh','dist/askpass/askpass.sh');require('fs').cpSync('src/askpass/askpass-empty.sh','dist/askpass/askpass-empty.sh')\"",
		"start": "npm run compile && electron .",
		"dist": "npm run compile && electron-builder"
	},
	"dependencies": {
		"chokidar": "3.6.0",
		"electron-updater": "^6.8.9",
		"iconv-lite": "0.5.0",
		"monaco-editor": "0.49.0"
	},
	"devDependencies": {
		"@types/node": "^24.9.0",
		"electron": "43.1.1",
		"electron-builder": "^26.15.3",
		"typescript": "5.4.5"
	},
	"build": {
		"appId": "com.mhutchie.git-graph-standalone",
		"productName": "Git Graph",
		"asar": false,
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"index.html",
			"norepos.html",
			"panel.js",
			"sidebar.js",
			"conflicts.js",
			"package.json"
		],
		"extraResources": [
			{
				"from": "../media",
				"to": "media"
			}
		],
		"publish": {
			"provider": "github",
			"owner": "akirasane",
			"repo": "git-graph-standalone"
		},
		"win": {
			"target": "nsis",
			"icon": "icon-256.png",
			"signExecutable": false,
			"verifyUpdateCodeSignature": false
		},
		"mac": {
			"target": "dmg",
			"icon": "icon-256.png"
		},
		"linux": {
			"target": "AppImage",
			"icon": "icon-256.png"
		}
	}
}
